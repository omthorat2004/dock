# --- Application -------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=Dock API

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot in production while this is the default.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Auth cookies ------------------------------------------------------------
# Must be true in production (required over HTTPS); false for local http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# --- Database ----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dock

# --- CORS --------------------------------------------------------------------
# JSON list. Credentials are sent, so a wildcard is not allowed.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
